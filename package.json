{
  "name": "nexo-bot",
  "version": "1.0.0",
  "description": "Modern Discord Bot",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && node node_modules/typescript/bin/tsc",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "start": "node dist/index.js",
    "render-build": "npm install && npm run deploy"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jimp": "^0.22.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
